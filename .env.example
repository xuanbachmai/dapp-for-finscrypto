# Copy this file to .env at the repository root, then fill in the Supabase keys.
# All Nuxt scripts explicitly load ../../.env from apps/web.

# Required for Activity verification and Progress.
# Install the Supabase CLI, then run `pnpm db:start` and `pnpm db:status` from the repository root.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Ethereum Sepolia (chainId 11155111). Use a reliable provider URL for server verification.
NUXT_SEPOLIA_RPC_URL=

# Public addresses written by DeployApprovalLab.s.sol after deploying to Sepolia.
NUXT_PUBLIC_FINS_TOKEN_ADDRESS=
NUXT_PUBLIC_AUD_TOKEN_ADDRESS=0x3676b864a37b31dfe6372384de7d02d27F6FF4e4
NUXT_PUBLIC_DRAINER_ROUND1_ADDRESS=
NUXT_PUBLIC_DRAINER_ROUND2_ADDRESS=
NUXT_PUBLIC_AUD_DRAINER_ROUND1_ADDRESS=
NUXT_PUBLIC_AUD_DRAINER_ROUND2_ADDRESS=
NUXT_PUBLIC_FAKE_AIRDROP_ADDRESS=
NUXT_PUBLIC_APPROVAL_LAB_ADDRESS=
NUXT_PUBLIC_SURVIVOR_BADGE_ADDRESS=

# Existing course platform used for wallet verification and shared navigation.
NUXT_PUBLIC_PLATFORM_URL=https://finscrypto.xyz

# Optional. Browser extension wallets work without a WalletConnect project ID.
NUXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
