# Copy this file to .env at the repository root, then fill in the Supabase keys.
# All Nuxt scripts explicitly load ../../.env from apps/web.

# Required for Activity verification and Progress.
# Run `pnpm dlx supabase start` and `pnpm dlx supabase status` from the repository root.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Local Anvil Chain (chainId 31337) used for the Approval & Drain Lab in this standalone build.
# When the lab moves onto the course platform, this becomes NUXT_SEPOLIA_RPC_URL.
NUXT_LOCAL_RPC_URL=http://127.0.0.1:8545

# FINSCRYPTO (chainId 36475547, the course Chain). Same setting name as the course platform.
NUXT_FINSCRYPTO_RPC_URL=https://chain.finscrypto.xyz/rpc/

# Optional. Browser extension wallets work without a WalletConnect project ID.
NUXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
